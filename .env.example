# Skopiuj do .env i uzupełnij. Sekrety wygeneruj np.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=app
JWT_SECRET=ZMIEN_MNIE_na_co_najmniej_32_losowe_znaki_xxxxxxxx
SESSION_SECRET=ZMIEN_MNIE_tez_losowy_napis_xxxxxxxxxxxxxxxxxxxxxx
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Konto administratora tworzone przy starcie API (puste = nie twórz)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# OAuth (4.0) – z https://github.com/settings/developers -> New OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/oauth/callback
